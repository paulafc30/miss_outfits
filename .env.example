VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY_AQUI

# Pinterest pausado (permiso de API denegado). Solo hace falta si se reactiva la integración.
# VITE_PINTEREST_CLIENT_ID=TU_PINTEREST_CLIENT_ID

# hCaptcha (site key PÚBLICA). Solo si activas CAPTCHA en Supabase (Authentication → Attack Protection).
# El secret va en el Dashboard de Supabase, nunca aquí. Si lo dejas vacío, no se muestra captcha.
# VITE_HCAPTCHA_SITE_KEY=TU_SITE_KEY

# Formspree (feedback por email) — crea un form gratis en https://formspree.io
# El valor es solo el ID del form (lo que va tras /f/ en tu endpoint)
VITE_FORMSPREE_FORM_ID=TU_FORMSPREE_FORM_ID

# (Opcional) URL de tu perfil de Vinted. Solo se usa si se reactiva la sincronización con Vinted (pausada)
# VITE_VINTED_PROFILE_URL=https://www.vinted.es/member/TU_ID
